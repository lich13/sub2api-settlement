SOURCE_DATABASE_URL=postgresql://settlement_reader:CHANGE_ME@sub2api-postgres:5432/sub2api
PUBLIC_ORIGIN=https://example.invalid
SUB2API_VERIFY_URL=http://sub2api:8080
DATA_DIR=/data
SETTLEMENT_ENV=production
APP_REVISION=local
# Optional runtime settings (defaults shown). The image supplies its asset path.
# SETTLEMENT_BIND=0.0.0.0:18082
# SETTLEMENT_BACKGROUND=true
# SETTLEMENT_READ_ONLY=false
# SETTLEMENT_EXTERNAL_WRITES=true
# SETTLEMENT_ASSETS=/app/frontend/dist
# RUST_LOG=settlement=info
# SOURCE_FIXTURE and SETTLEMENT_TEST_NOW are for isolated test environments only.
# Optional request limits; forwarded client IP is accepted only from explicit proxies.
SETTLEMENT_SSO_PER_MINUTE=30
SETTLEMENT_WRITES_PER_MINUTE=120
SETTLEMENT_TRUSTED_PROXIES=""
# Metrics stay private unless enabled. Non-loopback scrapers require a secret token.
SETTLEMENT_METRICS_ENABLED=false
SETTLEMENT_METRICS_TOKEN=""
# Optional signed webhook; off by default. Keep the URL and secret outside Git.
SETTLEMENT_REMINDERS_ENABLED=false
SETTLEMENT_REMINDER_URL=""
SETTLEMENT_REMINDER_SECRET=""
SETTLEMENT_REMINDER_HOUR=9
